df_Divar['created_at_month'] = pd.to_datetime(df_Divar['created_at_month'])

monthly_counts = df_Divar.groupby(['created_at_month', 'cat2_slug']).size().unstack(fill_value=0)
plt.figure(figsize=(10, 6))
for column in monthly_counts.columns:
